# ============================================================
# .env.example — OpenClaw Lightning Economic Layer
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. It contains your Lightning keys.
#
# Where to find these values:
#   LNBits → Wallet → API Info panel
#   Invoice/read key → LNBITS_*_INVOICE_KEY
#   Admin key        → LNBITS_*_ADMIN_KEY (treasury wallet only)
#
# Your LNBits instance URL:
#   Umbrel: http://umbrel.local:3007
#   Remote: https://your-lnbits-instance.com
# ============================================================

# ------------------------------------------------------------
# LNBits Instance
# ------------------------------------------------------------

LNBITS_BASE_URL=http://umbrel.local:3007

# ------------------------------------------------------------
# Treasury Wallet (Jet)
# Admin key — can send payments. Guard this carefully.
# Invoice key — read-only (can receive and check balance).
# ------------------------------------------------------------

LNBITS_TREASURY_ADMIN_KEY=your_treasury_admin_key_here
LNBITS_TREASURY_INVOICE_KEY=your_treasury_invoice_key_here

# ------------------------------------------------------------
# Agent Wallets (invoice keys only — agents cannot self-spend)
# The treasury (Jet) pays on behalf of agents after approval.
# ------------------------------------------------------------

LNBITS_FORGE_INVOICE_KEY=your_forge_invoice_key_here
LNBITS_SCOUT_INVOICE_KEY=your_scout_invoice_key_here
LNBITS_QUILL_INVOICE_KEY=your_quill_invoice_key_here
LNBITS_ATLAS_INVOICE_KEY=your_atlas_invoice_key_here
LNBITS_ORACLE_INVOICE_KEY=your_oracle_invoice_key_here
LNBITS_PIXEL_INVOICE_KEY=your_pixel_invoice_key_here
LNBITS_RENDER_INVOICE_KEY=your_render_invoice_key_here
LNBITS_CIPHER_INVOICE_KEY=your_cipher_invoice_key_here

# ------------------------------------------------------------
# Approval gates
# Spends above THRESHOLD require Jet approval.
# Spends above HUMAN_THRESHOLD require Michael's approval.
# ------------------------------------------------------------

LIGHTNING_APPROVAL_THRESHOLD_SATS=5000
LIGHTNING_HUMAN_APPROVAL_THRESHOLD_SATS=50000
LIGHTNING_WEEKLY_BUDGET_SATS=50000
